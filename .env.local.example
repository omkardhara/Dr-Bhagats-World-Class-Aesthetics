# Sanity project credentials — https://sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-10-01"

# Write-enabled token, used only by seedSanity.ts. Never expose to the client.
SANITY_API_WRITE_TOKEN=""

# Server-side read token (Viewer scope), for server components.
SANITY_API_READ_TOKEN=""

# Optional, development only. Set to your dev server origin (e.g.
# "http://localhost:3000") ONLY if the Studio hangs on "Trying to connect...",
# which happens when endpoint-security software buffers streaming responses.
# Leave empty otherwise.
NEXT_PUBLIC_SANITY_DEV_PROXY_ORIGIN=""

# Canonical site origin (no trailing slash), e.g. "https://www.drbhagats.com"
NEXT_PUBLIC_SITE_URL=""
