# Sanity project credentials — https://sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2024-10-01"

# Write-enabled token, used only by seedSanity.ts. Never expose to the client.
SANITY_API_WRITE_TOKEN=""

# Server-side read token (Viewer scope), for server components.
SANITY_API_READ_TOKEN=""
